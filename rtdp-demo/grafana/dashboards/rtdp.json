        },
        "barWidth": 0.7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(b.branch_name = '', toString(t.branch_id), b.branch_name) AS chi_nhanh,\n       toFloat64(sum(t.amount)) AS doanh_so\nFROM rtdp.v_txn AS t\nLEFT JOIN rtdp.v_branch AS b ON t.branch_id = b.branch_id\nWHERE $__timeFilter(t.created_at)\nGROUP BY chi_nhanh\nORDER BY doanh_so DESC",
          "refId": "A"
        }
      ]
