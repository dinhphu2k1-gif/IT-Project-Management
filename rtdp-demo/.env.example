# Sao chép thành .env nếu muốn đổi giá trị mặc định:  cp .env.example .env
# docker compose, scripts/*.sh tự đọc file .env. Với script Python, nạp trước bằng:
#   set -a; . ./.env; set +a

# Oracle
ORACLE_PASSWORD=oracle        # mật khẩu SYS/SYSTEM
CORE_PASSWORD=core            # user schema CORE (script Python dùng)
GGADMIN_PASSWORD=ggadmin      # user ggadmin (PDB) và c##ggadmin (CDB) cho GoldenGate
ORACLE_PORT=1521
ORACLE_DSN=localhost:1521/FREEPDB1

# Kafka: địa chỉ mà GoldenGate DAA dùng để kết nối (máy host)
KAFKA_EXTERNAL_HOST=localhost

# ClickHouse
CLICKHOUSE_USER=rtdp
CLICKHOUSE_PASSWORD=rtdp
CLICKHOUSE_URL=http://localhost:8123

# Grafana
GRAFANA_ADMIN_PASSWORD=admin
